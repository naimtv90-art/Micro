<%- include('partials/header') %>

<section class="section" style="background: linear-gradient(135deg, #07381b 0%, #0d562b 100%); color: #fff; padding: 60px 0;">
  <div class="container" style="text-align: center;">
    <span class="hero-badge" style="background: rgba(255,255,255,0.15);">Practical Reading</span>
    <h1 style="font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; margin-bottom: 14px; color: #fff;">
      MHCC Ear Care &amp; Audiology Blog
    </h1>
    <p style="max-width: 720px; margin: 0 auto; color: #d1fae5; font-size: 1.15rem; line-height: 1.6;">
      Practical reading on hearing health, digital hearing aids, and everyday ear care tips from the audiologists at Micro Hearing Care Centre.
    </p>
  </div>
</section>

<!-- Blog Articles Grid -->
<section class="section">
  <div class="container">
    <div class="grid-3-col">
      <!-- Post 1 -->
      <article style="background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
        <div style="background: #eaf5ee; height: 180px; display: flex; align-items: center; justify-content: center; font-size: 50px;">
          🦻
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
          <span style="font-size: 0.8rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; margin-bottom: 8px;">General Audiology</span>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; line-height: 1.4;">
            Hello World! Welcome to Micro Hearing Care Centre
          </h2>
          <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 18px; flex-grow: 1;">
            Welcome to our online hearing healthcare resource. Discover why early diagnosis of hearing loss is crucial and how digital micro technology restores natural clarity.
          </p>
          <div style="padding-top: 14px; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.85rem; color: #94a3b8;">5 min read</span>
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary);">Read Guide &rarr;</span>
          </div>
        </div>
      </article>

      <!-- Post 2 -->
      <article style="background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
        <div style="background: #f0f9ff; height: 180px; display: flex; align-items: center; justify-content: center; font-size: 50px;">
          🔍
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
          <span style="font-size: 0.8rem; font-weight: 700; color: #0284c7; text-transform: uppercase; margin-bottom: 8px;">Device Maintenance</span>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; line-height: 1.4;">
            How to Clean &amp; Protect Hearing Aids in Humid Weather
          </h2>
          <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 18px; flex-grow: 1;">
            Essential maintenance tips for Bangladesh's humid seasons: using drying capsules, clearing earwax cerumen guards, and protecting micro-receivers.
          </p>
          <div style="padding-top: 14px; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.85rem; color: #94a3b8;">4 min read</span>
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary);">Read Guide &rarr;</span>
          </div>
        </div>
      </article>

      <!-- Post 3 -->
      <article style="background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-xl); overflow: hidden; box-shadow: var(--shadow-sm); display: flex; flex-direction: column;">
        <div style="background: #fdf2f8; height: 180px; display: flex; align-items: center; justify-content: center; font-size: 50px;">
          👶
        </div>
        <div style="padding: 24px; display: flex; flex-direction: column; flex-grow: 1;">
          <span style="font-size: 0.8rem; font-weight: 700; color: #db2777; text-transform: uppercase; margin-bottom: 8px;">Pediatric Audiology</span>
          <h2 style="font-size: 1.25rem; font-weight: 800; color: #0f172a; margin-bottom: 10px; line-height: 1.4;">
            Early Signs of Hearing Loss in Children &amp; Toddlers
          </h2>
          <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6; margin-bottom: 18px; flex-grow: 1;">
            A parent’s guide to identifying delayed speech development, lack of startle response to loud sounds, and pediatric hearing screening solutions.
          </p>
          <div style="padding-top: 14px; border-top: 1px solid var(--color-border-subtle); display: flex; justify-content: space-between; align-items: center;">
            <span style="font-size: 0.85rem; color: #94a3b8;">6 min read</span>
            <span style="font-size: 0.9rem; font-weight: 700; color: var(--color-primary);">Read Guide &rarr;</span>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
