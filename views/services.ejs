<%- include('partials/header') %>

<!-- Page Hero -->
<section class="section" style="background: linear-gradient(135deg, #07381b 0%, #0d562b 100%); color: #fff; padding: 60px 0;">
  <div class="container" style="text-align: center;">
    <span class="hero-badge" style="background: rgba(255,255,255,0.15);">Clinical Audiology Services</span>
    <h1 style="font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; margin-bottom: 14px; color: #fff;">
      Comprehensive Hearing Care &amp; Clinical Diagnostics
    </h1>
    <p style="max-width: 720px; margin: 0 auto; color: #d1fae5; font-size: 1.1rem; line-height: 1.6;">
      Soundproof booth evaluations for all ages, custom earmould fabrication, precision digital fittings, and 5 years of free routine servicing at our Uttara and Gazipur clinics.
    </p>
  </div>
</section>

<!-- Full-Spectrum Services Grid -->
<section class="section">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Our Expertise</span>
      <h2 class="section-title">Full-Spectrum Hearing Care Services</h2>
      <p class="section-subtitle">Delivered by university-trained audiology specialists with certified diagnostic equipment.</p>
    </div>

    <div class="services-grid">
      <!-- 1 -->
      <div class="service-card">
        <div class="service-icon-box">🎧</div>
        <h3>Hearing Test &amp; Evaluation</h3>
        <p>Comprehensive Pure Tone Audiometry (PTA), Speech Audiometry, and middle-ear Tympanometry inside double-walled acoustic soundproof chambers.</p>
        <span class="service-card-link">Soundproof Booth Testing</span>
      </div>

      <!-- 2 -->
      <div class="service-card">
        <div class="service-icon-box">🦻</div>
        <h3>Digital Hearing Aid Dispensing</h3>
        <p>Precise real-ear verification and personalized programming of world-leading instruments from Phonak, Rexton, and Unitron for optimal clarity.</p>
        <span class="service-card-link">Authorized Global Brands</span>
      </div>

      <!-- 3 -->
      <div class="service-card">
        <div class="service-icon-box">🧪</div>
        <h3>Ear Mould &amp; Shell Facility</h3>
        <p>In-house specialized laboratory crafting custom soft silicone and hard acrylic earmoulds, swim plugs, and noise filters for a snug, leak-free acoustic seal.</p>
        <span class="service-card-link">In-House Custom Lab</span>
      </div>

      <!-- 4 -->
      <div class="service-card">
        <div class="service-icon-box">🔧</div>
        <h3>Repair &amp; Lab Servicing</h3>
        <p>Micro-soldering, transducer replacement, acoustic tubing renewal, ultrasonic drying, and chamber diagnostics for all hearing aid makes and models.</p>
        <span class="service-card-link">Rapid Turnaround Repair</span>
      </div>

      <!-- 5 -->
      <div class="service-card">
        <div class="service-icon-box">🔔</div>
        <h3>Tinnitus Management</h3>
        <p>Structured acoustic sound enrichment, frequency masking, and audiologist counseling to alleviate persistent ear ringing, buzzing, or clicking.</p>
        <span class="service-card-link">Relief Therapy</span>
      </div>

      <!-- 6 -->
      <div class="service-card">
        <div class="service-icon-box">🔋</div>
        <h3>Accessories &amp; Batteries</h3>
        <p>Original German zinc-air batteries (Sizes 10, 312, 13, 675), desiccating drying capsules, wax filters, dome ear tips, and Roger wireless microphones.</p>
        <span class="service-card-link">100% Genuine Supplies</span>
      </div>
    </div>
  </div>
</section>

<!-- Evaluation Steps -->
<section class="section section-bg-light">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Standard of Care</span>
      <h2 class="section-title">What to Expect at Your Evaluation</h2>
      <p class="section-subtitle">A transparent, pain-free 3-step clinical assessment.</p>
    </div>

    <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 24px;">
      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <div style="width: 44px; height: 44px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; margin-bottom: 16px;">1</div>
        <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 10px;">Detailed Case History</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          We discuss your daily listening challenges, medical background, noise exposure history, and personal hearing communication goals.
        </p>
      </div>

      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <div style="width: 44px; height: 44px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; margin-bottom: 16px;">2</div>
        <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 10px;">Otoscopic Ear Check</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          High-definition video otoscopy inspection of your outer ear canal and eardrum to rule out wax blockage or middle ear fluid.
        </p>
      </div>

      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <div style="width: 44px; height: 44px; background: var(--color-primary); color: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.2rem; margin-bottom: 16px;">3</div>
        <h3 style="font-size: 1.2rem; font-weight: 700; margin-bottom: 10px;">Soundproof Booth Testing</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          Calibrated tone and speech stimulus testing across all octaves to map your exact hearing threshold curve (audiogram).
        </p>
      </div>
    </div>
  </div>
</section>

<!-- 5-Year Free Routine Servicing Commitment -->
<section class="section">
  <div class="container">
    <div style="background: linear-gradient(135deg, #093b1e 0%, #156c37 100%); color: #fff; border-radius: var(--radius-xl); padding: 50px 40px; box-shadow: var(--shadow-xl);">
      <div style="max-width: 800px; margin: 0 auto; text-align: center;">
        <span class="hero-badge" style="background: rgba(255,255,255,0.15);">Unmatched Aftercare Guarantee</span>
        <h2 style="font-size: clamp(1.8rem, 3vw, 2.6rem); font-weight: 800; color: #fff; margin-bottom: 16px;">
          Free 6-Monthly Servicing for 5 Years
        </h2>
        <p style="font-size: 1.1rem; color: #d1fae5; line-height: 1.7; margin-bottom: 30px;">
          Our relationship begins, not ends, with your first fitting. Every hearing aid purchased from Micro Hearing Care Centre comes backed by 5 full years of complimentary routine clinic maintenance.
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 20px;">
        <div style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); padding: 20px; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.15);">
          <strong style="color: #4ade80; display: block; margin-bottom: 6px;">Deep Port Vacuuming</strong>
          <span style="font-size: 0.9rem; color: #e2e8f0;">Micro-vacuum extraction of deep earwax, skin debris, and dust from mic ports and speakers.</span>
        </div>
        <div style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); padding: 20px; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.15);">
          <strong style="color: #4ade80; display: block; margin-bottom: 6px;">Acoustic Chamber Calibration</strong>
          <span style="font-size: 0.9rem; color: #e2e8f0;">Digital testing in 2cc coupler test boxes to ensure original factory gain and low harmonic distortion.</span>
        </div>
        <div style="background: rgba(255,255,255,0.1); backdrop-filter: blur(8px); padding: 20px; border-radius: var(--radius-md); border: 1px solid rgba(255,255,255,0.15);">
          <strong style="color: #4ade80; display: block; margin-bottom: 6px;">2-Year Free Audiometric Retest</strong>
          <span style="font-size: 0.9rem; color: #e2e8f0;">Periodic re-evaluation of your hearing thresholds to recalibrate devices if hearing evolves over time.</span>
        </div>
      </div>

      <div style="text-align: center; margin-top: 36px;">
        <button class="btn btn-red btn-lg" data-open-appointment="uttara">Schedule Your Clinic Appointment</button>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
