  <!-- Interactive Appointment Booking Modal -->
  <div id="appointmentModal" class="modal-overlay">
    <div class="modal-box">
      <button id="closeAppointmentModal" class="modal-close-btn">&times;</button>
      <div style="text-align: center; margin-bottom: 24px;">
        <span class="section-badge">Fast &amp; Easy</span>
        <h3 style="font-size: 1.5rem; font-weight: 800; color: #0f172a;">Book a Hearing Consultation</h3>
        <p style="font-size: 0.9rem; color: #64748b; margin-top: 4px;">Visit our clinic in Uttara or Gazipur for a comprehensive test.</p>
      </div>

      <form data-booking-form>
        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input type="text" name="name" required class="form-control" placeholder="e.g. Mohammad Rahman">
        </div>
        <div class="form-group">
          <label class="form-label">Phone Number *</label>
          <input type="tel" name="phone" required class="form-control" placeholder="017XXXXXXXX">
        </div>
        <div class="form-group">
          <label class="form-label">Select Clinic Branch *</label>
          <select name="branch" class="form-control">
            <option value="uttara">Uttara Head Office (Sector-11)</option>
            <option value="gazipur">Gazipur Branch (Chandana Chowrasta)</option>
          </select>
        </div>
        <div class="form-group">
          <label class="form-label">Preferred Date &amp; Time</label>
          <input type="text" name="preferredDate" class="form-control" placeholder="e.g. Tomorrow afternoon">
        </div>
        <div class="form-group">
          <label class="form-label">Hearing Concerns / Notes</label>
          <textarea name="message" rows="2" class="form-control" placeholder="Briefly describe your hearing requirements..."></textarea>
        </div>
        <button type="submit" class="btn btn-primary" style="width: 100%; border-radius: var(--radius-pill); padding: 14px;">
          Confirm Booking Request
        </button>
      </form>
    </div>
