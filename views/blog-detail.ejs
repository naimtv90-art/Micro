<%- include('partials/header') %>

<section class="section" style="padding-top: 36px; padding-bottom: 70px; background: #ffffff;">
  <div class="container" style="max-width: 860px;">
    <!-- Breadcrumbs -->
    <div style="font-size: 0.9rem; color: #64748b; margin-bottom: 24px;">
      <a href="/" style="color: var(--color-primary); text-decoration: none;">Home</a> &nbsp;/&nbsp; 
      <a href="/blog" style="color: var(--color-primary); text-decoration: none;">Blog</a> &nbsp;/&nbsp; 
      <span style="color: #0f172a; font-weight: 600;"><%= blog.title %></span>
    </div>

    <!-- Article Header -->
    <header style="margin-bottom: 32px;">
      <div style="display: flex; align-items: center; gap: 12px; margin-bottom: 16px;">
        <span style="background: var(--color-primary-soft); color: var(--color-primary); font-size: 0.82rem; font-weight: 800; padding: 4px 14px; border-radius: var(--radius-pill); text-transform: uppercase;">
          <%= blog.category %>
        </span>
        <span style="font-size: 0.85rem; color: #64748b;">
          ⏱ <%= blog.readTime %>
        </span>
        <span style="font-size: 0.85rem; color: #94a3b8;">&bull;</span>
        <span style="font-size: 0.85rem; color: #64748b;">
          📅 <%= blog.date %>
        </span>
      </div>

      <h1 style="font-size: clamp(2rem, 3.2vw, 2.75rem); font-weight: 800; color: #06381d; line-height: 1.25; margin-bottom: 20px;">
        <%= blog.title %>
      </h1>

      <div style="display: flex; align-items: center; justify-content: space-between; padding-bottom: 24px; border-bottom: 1px solid var(--color-border); flex-wrap: wrap; gap: 16px;">
        <div style="display: flex; align-items: center; gap: 12px;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #006837; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 800; font-size: 1.1rem;">
            🦻
          </div>
          <div>
            <strong style="color: #0f172a; display: block; font-size: 0.95rem;"><%= blog.author %></strong>
            <span style="font-size: 0.82rem; color: #64748b;">Micro Hearing Care Centre Bangladesh</span>
          </div>
        </div>

        <div style="display: flex; gap: 8px;">
          <a href="https://wa.me/?text=<%= encodeURIComponent(blog.title + ' - ' + site.domain + '/blog/' + blog.slug) %>" target="_blank" class="btn btn-whatsapp btn-sm" style="border-radius: 9999px;">
            Share on WhatsApp
          </a>
        </div>
      </div>
    </header>

    <!-- Featured Hero Image -->
    <div style="border-radius: var(--radius-xl); overflow: hidden; margin-bottom: 40px; box-shadow: var(--shadow-md); max-height: 440px; background: #eaf5ee;">
      <img src="<%= blog.image %>" alt="<%= blog.title %>" style="width: 100%; height: 100%; object-fit: cover; display: block;">
    </div>

    <!-- Article Body -->
    <article class="article-content" style="font-size: 1.12rem; line-height: 1.85; color: #334155;">
      <%- blog.content %>
    </article>

    <!-- Clinic Key Takeaways Box -->
    <div style="margin: 48px 0; background: #f0fdf4; border: 1.5px solid #bbf7d0; border-radius: var(--radius-lg); padding: 28px 32px;">
      <h3 style="font-size: 1.2rem; font-weight: 800; color: #166534; margin-bottom: 12px; display: flex; align-items: center; gap: 8px;">
        <span>💡</span> Need Audiological Care in Bangladesh?
      </h3>
      <p style="color: #14532d; font-size: 1rem; line-height: 1.6; margin-bottom: 18px;">
        Micro Hearing Care Centre (MHCC) provides complete clinical audiology evaluations, hearing aid trials, custom earmould fabrication, and lifetime routine servicing in Uttara (Dhaka) and Gazipur.
      </p>
      <div style="display: flex; gap: 12px; flex-wrap: wrap;">
        <button class="btn btn-primary" data-open-appointment="uttara">
          Book Appointment at Uttara
        </button>
        <button class="btn btn-outline" data-open-appointment="gazipur">
          Book at Gazipur Branch
        </button>
        <a href="tel:01787519995" class="btn btn-red">
          📞 01787 51 999 5
        </a>
      </div>
    </div>

    <!-- Related Articles -->
    <% if (relatedBlogs && relatedBlogs.length > 0) { %>
      <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--color-border);">
        <h3 style="font-size: 1.5rem; font-weight: 800; color: #0f172a; margin-bottom: 24px;">
          More Audiology Reading
        </h3>
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 20px;">
          <% relatedBlogs.forEach(rel => { %>
            <div style="background: #f8faf9; border: 1px solid var(--color-border); border-radius: var(--radius-lg); padding: 20px; display: flex; flex-direction: column;">
              <span style="font-size: 0.75rem; font-weight: 700; color: var(--color-primary); text-transform: uppercase; margin-bottom: 8px;">
                <%= rel.category %>
              </span>
              <h4 style="font-size: 1.05rem; font-weight: 800; color: #0f172a; margin-bottom: 8px; line-height: 1.4;">
                <a href="/blog/<%= rel.slug %>" style="color: inherit; text-decoration: none;">
                  <%= rel.title %>
                </a>
              </h4>
              <p style="color: #64748b; font-size: 0.88rem; line-height: 1.5; margin-bottom: 14px; flex-grow: 1;">
                <%= (rel.excerpt || '').substring(0, 110) %>...
              </p>
              <a href="/blog/<%= rel.slug %>" style="color: var(--color-primary); font-weight: 700; font-size: 0.88rem; text-decoration: none;">
                Read Article &rarr;
              </a>
            </div>
          <% }); %>
        </div>
      </div>
    <% } %>

    <div style="margin-top: 40px; text-align: center;">
      <a href="/blog" class="btn btn-outline" style="border-radius: 9999px;">
        &larr; Back to All Blog Articles
      </a>
    </div>
  </div>
</section>

<style>
  .article-content h2 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #06381d;
    margin: 36px 0 16px;
    line-height: 1.3;
  }
  .article-content h3 {
    font-size: 1.3rem;
    font-weight: 800;
    color: #0f172a;
    margin: 28px 0 12px;
  }
  .article-content p {
    margin-bottom: 20px;
  }
  .article-content ul, .article-content ol {
    margin: 0 0 24px 28px;
  }
  .article-content li {
    margin-bottom: 10px;
  }
  .article-content strong {
    color: #0f172a;
  }
  .article-content blockquote {
    border-left: 4px solid var(--color-primary);
    padding: 14px 20px;
    background: #f8faf9;
    border-radius: 0 var(--radius-md) var(--radius-md) 0;
    font-style: italic;
    color: #475569;
    margin: 24px 0;
  }
</style>

<%- include('partials/footer') %>
