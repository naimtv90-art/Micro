<%- include('partials/header') %>

<style>
/* Continuous Hero Product Carousel (Side to side motion) */
.ahcc-ps {
  position: relative;
  width: 100%;
  box-sizing: border-box;
  margin-top: 30px;
}
.ahcc-ps * {
  box-sizing: border-box;
}
.ahcc-ps-viewport {
  overflow-x: auto;
  overflow-y: hidden;
  scroll-behavior: smooth;
  scroll-snap-type: x mandatory;
  scrollbar-width: none;
  -ms-overflow-style: none;
  -webkit-overflow-scrolling: touch;
  padding: 8px 4px 20px;
  outline: none;
}
.ahcc-ps-viewport::-webkit-scrollbar {
  display: none;
}
.ahcc-ps-track {
  display: flex !important;
  flex-direction: row !important;
  flex-wrap: nowrap !important;
  gap: 16px !important;
  align-items: stretch;
}
.ahcc-ps a.ahcc-ps-card {
  flex: 0 0 190px !important;
  width: 190px !important;
  min-width: 190px !important;
  max-width: 190px !important;
  scroll-snap-align: start;
  display: flex !important;
  flex-direction: column !important;
  background: #ffffff !important;
  border: 1px solid #dcebd6 !important;
  border-radius: 18px !important;
  padding: 12px !important;
  color: #0a1f0c !important;
  text-decoration: none !important;
  box-shadow: 0 10px 24px -8px rgba(0, 0, 0, 0.35) !important;
  transition: transform 0.25s ease, box-shadow 0.25s ease !important;
  user-select: none;
}
.ahcc-ps a.ahcc-ps-card:hover {
  transform: translateY(-5px) !important;
  box-shadow: 0 16px 30px -6px rgba(0, 0, 0, 0.45) !important;
}
.ahcc-ps-img {
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  height: 150px !important;
  background: #f2f9ef !important;
  border-radius: 14px !important;
  padding: 12px !important;
  overflow: hidden !important;
}
.ahcc-ps-img img {
  display: block !important;
  max-width: 100% !important;
  max-height: 100% !important;
  width: auto !important;
  height: auto !important;
  object-fit: contain !important;
  transition: transform 0.25s ease !important;
}
.ahcc-ps a.ahcc-ps-card:hover .ahcc-ps-img img {
  transform: scale(1.08) !important;
}
.ahcc-ps-title {
  margin-top: 10px !important;
  font-size: 0.92rem !important;
  font-weight: 700 !important;
  line-height: 1.35 !important;
  color: #0a1f0c !important;
  text-align: center !important;
  white-space: nowrap !important;
  overflow: hidden !important;
  text-overflow: ellipsis !important;
  text-transform: capitalize !important;
}
.ahcc-ps button.ahcc-ps-btn {
  position: absolute !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  z-index: 10 !important;
  width: 44px !important;
  height: 44px !important;
  border: 0 !important;
  border-radius: 50% !important;
  background: #ffffff !important;
  color: #006837 !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
  cursor: pointer !important;
  box-shadow: 0 6px 20px rgba(0, 0, 0, 0.35) !important;
  transition: all 0.2s ease !important;
}
.ahcc-ps button.ahcc-ps-btn:hover {
  background: #006837 !important;
  color: #ffffff !important;
  transform: translateY(-50%) scale(1.1) !important;
}
.ahcc-ps-prev {
  left: -20px !important;
}
.ahcc-ps-next {
  right: -20px !important;
}

@media (max-width: 768px) {
  .ahcc-ps a.ahcc-ps-card {
    flex: 0 0 150px !important;
    width: 150px !important;
    min-width: 150px !important;
    max-width: 150px !important;
    padding: 10px !important;
  }
  .ahcc-ps-img {
    height: 120px !important;
    padding: 8px !important;
  }
  .ahcc-ps-prev { left: -8px !important; }
  .ahcc-ps-next { right: -8px !important; }
}

@media (max-width: 480px) {
  .ahcc-ps {
    margin-top: 18px !important;
  }
  .ahcc-ps a.ahcc-ps-card {
    flex: 0 0 135px !important;
    width: 135px !important;
    min-width: 135px !important;
    max-width: 135px !important;
    padding: 8px !important;
    border-radius: 14px !important;
  }
  .ahcc-ps-img {
    height: 105px !important;
    padding: 6px !important;
    border-radius: 10px !important;
  }
  .ahcc-ps-title {
    font-size: 0.8rem !important;
    margin-top: 6px !important;
  }
  .ahcc-ps button.ahcc-ps-btn {
    width: 32px !important;
    height: 32px !important;
  }
  .ahcc-ps button.ahcc-ps-btn svg {
    width: 14px !important;
    height: 14px !important;
  }
  .ahcc-ps-prev { left: -4px !important; }
  .ahcc-ps-next { right: -4px !important; }
}
</style>

<!-- Hero Banner Section -->
<section class="hero-section">
  <div class="container">
    <div class="hero-top-content">
      <span class="hero-badge">Welcome to Micro Hearing Aid Centre</span>
      <h1 class="hero-title">We provide high quality hearing aids</h1>
      <p class="hero-desc">
        All types of hearing aids, tested and fitted by trained audiology specialists. Serving people of all ages in Bangladesh since 2014.
      </p>
      <div class="hero-buttons">
        <a href="tel:<%= site.emergencyHelplineRaw %>" class="btn btn-red btn-lg">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M6.62 10.79a15.053 15.053 0 006.59 6.59l2.2-2.2c.27-.27.67-.36 1.02-.24 1.12.37 2.33.57 3.57.57.55 0 1 .45 1 1V20c0 .55-.45 1-1 1-9.39 0-17-7.61-17-17 0-.55.45-1 1-1h3.5c.55 0 1 .45 1 1 0 1.25.2 2.45.57 3.57.11.35.03.74-.25 1.02l-2.2 2.2z"/></svg>
          Call <%= site.emergencyHelpline %>
        </a>
        <a href="<%= site.whatsappLink %>" target="_blank" class="btn btn-whatsapp btn-lg">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38c1.45.79 3.08 1.21 4.74 1.21 5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.816 9.816 0 0012.04 2zm.01 1.67c2.2 0 4.26.86 5.82 2.42a8.225 8.225 0 012.41 5.83c0 4.54-3.7 8.24-8.24 8.24-1.44 0-2.85-.38-4.08-1.1l-.29-.17-3.04.8 1.05-2.97-.19-.3a8.188 8.188 0 01-1.25-4.5c0-4.54 3.7-8.24 8.24-8.24zm4.52 11.66c-.25-.13-1.47-.72-1.7-.81-.23-.08-.39-.13-.56.13-.17.25-.64.81-.79.97-.14.17-.29.19-.54.06-.25-.13-1.06-.39-2.02-1.24-.74-.66-1.24-1.48-1.39-1.73-.14-.25-.02-.38.11-.51.11-.11.25-.29.37-.44.13-.14.17-.25.25-.42.08-.17.04-.31-.02-.44-.06-.13-.56-1.34-.76-1.84-.2-.49-.4-.42-.56-.43h-.48c-.17 0-.44.06-.67.31-.23.25-.88.86-.88 2.1 0 1.24.9 2.44 1.03 2.61.13.17 1.77 2.7 4.29 3.79.6.26 1.07.41 1.43.53.6.19 1.15.16 1.58.1.48-.07 1.47-.6 1.68-1.18.21-.58.21-1.08.15-1.18-.06-.1-.23-.17-.48-.29z"/></svg>
          Book on WhatsApp
        </a>
      </div>
    </div>

    <!-- Continuous Product Slider (Moving from side to side) -->
    <div class="ahcc-ps" role="region" aria-roledescription="carousel" aria-label="Hearing aids" data-speed="2500" data-autoplay="1">
      <button type="button" class="ahcc-ps-btn ahcc-ps-prev" aria-label="Previous products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M15 19l-7-7 7-7"/>
        </svg>
      </button>

      <div class="ahcc-ps-viewport" tabindex="0">
        <div class="ahcc-ps-track">
          <% heroSliderProducts.forEach(item => { %>
            <a class="ahcc-ps-card" href="/product/<%= item.slug %>" draggable="false">
              <span class="ahcc-ps-img">
                <img src="<%= item.img %>" alt="<%= item.title %> – Digital Hearing Aid Micro Hearing Care Centre Bangladesh" loading="eager" draggable="false">
              </span>
              <span class="ahcc-ps-title"><%= item.title %></span>
            </a>
          <% }); %>
        </div>
      </div>

      <button type="button" class="ahcc-ps-btn ahcc-ps-next" aria-label="Next products">
        <svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round">
          <path d="M9 5l7 7-7 7"/>
        </svg>
      </button>
    </div>
  </div>
</section>

