<%- include('partials/header') %>

<section class="section" style="background: linear-gradient(135deg, #07381b 0%, #0d562b 100%); color: #fff; padding: 60px 0;">
  <div class="container" style="text-align: center;">
    <span class="hero-badge" style="background: rgba(255,255,255,0.15);">Our Vision &amp; Purpose</span>
    <h1 style="font-size: clamp(2rem, 3.5vw, 3rem); font-weight: 800; margin-bottom: 14px; color: #fff;">
      A Hearing Care Centre in All 64 Districts of Bangladesh
    </h1>
    <p style="max-width: 720px; margin: 0 auto; color: #d1fae5; font-size: 1.15rem; line-height: 1.6;">
      Our goal is to offer comprehensive, world-class hearing solutions to people of all classes, nationwide.
    </p>
  </div>
</section>

<!-- Mission Pillars -->
<section class="section">
  <div class="container">
    <div class="feature-row">
      <div>
        <span class="section-badge">Nationwide Reach</span>
        <h2 class="section-title">64 Centres in 64 Districts</h2>
        <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 20px;">
          We aspire to establish a Micro Hearing Care Centre in every one of Bangladesh’s 64 districts, so that no person, regardless of geography or economic standing, is forced to endure untreated hearing loss.
        </p>
        <p style="font-size: 1.05rem; color: #475569; line-height: 1.7; margin-bottom: 24px;">
          High-quality audiological diagnostics should not be restricted only to capital cities. Through mobile testing camps, clinical partnerships, and regional hub clinics, our journey is steadily expanding to reach every corner of the nation.
        </p>
        <button class="btn btn-primary btn-lg" data-open-appointment="uttara">Join Us in Better Hearing</button>
      </div>

      <div>
        <div style="background: #f8faf9; border: 1px solid var(--color-border); border-radius: var(--radius-xl); padding: 36px; box-shadow: var(--shadow-sm);">
          <h3 style="font-size: 1.4rem; color: #0f172a; margin-bottom: 16px;">Why Our Mission Matters:</h3>
          <div style="display: flex; flex-direction: column; gap: 14px;">
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="font-size: 24px;">🎯</span>
              <div>
                <strong style="color: #0f172a;">Early Childhood Development</strong>
                <p style="font-size: 0.9rem; color: #64748b;">Identifying congenital hearing impairment in infants under 1 year preserves speech, language, and schooling potential.</p>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="font-size: 24px;">💼</span>
              <div>
                <strong style="color: #0f172a;">Economic Independence</strong>
                <p style="font-size: 0.9rem; color: #64748b;">Enabling adults with hearing impairment to pursue productive employment and lead dignified lives.</p>
              </div>
            </div>
            <div style="display: flex; gap: 12px; align-items: flex-start;">
              <span style="font-size: 24px;">👴</span>
              <div>
                <strong style="color: #0f172a;">Healthy Cognitive Aging</strong>
                <p style="font-size: 0.9rem; color: #64748b;">Protecting seniors from dementia and depression, keeping elders active and engaged with their grandchildren.</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- Care that lasts beyond the first fitting -->
<section class="section section-bg-light">
  <div class="container">
    <div class="section-header">
      <span class="section-badge">Lifetime Commitment</span>
      <h2 class="section-title">Care That Lasts Beyond the First Fitting</h2>
    </div>

    <div class="grid-3-col">
      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Expert Fitting</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          Real-ear acoustic measurement ensuring that targets from the diagnostic audiogram match real-world ear canal acoustics.
        </p>
      </div>

      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Servicing Every 6 Months</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          Routine check-ups, vacuum debris removal, sound filter replacement, and electronic testing completely free for 5 years.
        </p>
      </div>

      <div style="background: #fff; padding: 30px; border-radius: var(--radius-lg); border: 1px solid var(--color-border);">
        <h3 style="font-size: 1.25rem; font-weight: 700; color: #0f172a; margin-bottom: 10px;">Reassessment Every 2 Years</h3>
        <p style="color: #64748b; font-size: 0.95rem; line-height: 1.6;">
          Comprehensive audiometric re-evaluation to fine-tune programs as natural hearing changes occur.
        </p>
      </div>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
