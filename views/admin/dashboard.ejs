<%- include('layout-header', { pageTitle: 'Admin Dashboard – Micro Hearing CMS', activeNav: 'dashboard' }) %>

<style>
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .dashboard-title h1 {
    font-size: 1.75rem;
    font-weight: 800;
    color: #06381d;
    margin-bottom: 4px;
  }
  .dashboard-title p {
    color: #64748b;
    font-size: 0.95rem;
  }
  .quick-actions {
    display: flex;
    gap: 10px;
  }
  .btn-action-primary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #006837;
    color: #ffffff;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 10px rgba(0, 104, 55, 0.25);
  }
  .btn-action-primary:hover {
    background: #0a4d29;
    transform: translateY(-1px);
    box-shadow: 0 6px 14px rgba(0, 104, 55, 0.35);
  }
  .btn-action-secondary {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #ffffff;
    color: #06381d;
    padding: 10px 18px;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid #cbd5e1;
    transition: all 0.2s ease;
  }
  .btn-action-secondary:hover {
    background: #f8fafc;
    border-color: #94a3b8;
  }

  /* Metric Cards Grid */
  .metrics-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 20px;
    margin-bottom: 32px;
  }
  .metric-card {
    background: #ffffff;
    border-radius: 16px;
    padding: 24px;
    border: 1px solid var(--admin-card-border);
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    position: relative;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }
  .metric-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 6px 16px rgba(0,0,0,0.06);
  }
  .metric-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    width: 4px;
    height: 100%;
    background: #006837;
  }
  .metric-card.accent-red::before {
    background: #c9252c;
  }
  .metric-card.accent-blue::before {
    background: #0284c7;
  }
  .metric-card.accent-purple::before {
    background: #7c3aed;
  }
  .metric-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 12px;
  }
  .metric-label {
    font-size: 0.85rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .metric-icon {
    font-size: 1.4rem;
  }
  .metric-value {
    font-size: 2.2rem;
    font-weight: 800;
    color: #0f172a;
    line-height: 1.1;
    margin-bottom: 6px;
  }
  .metric-sub {
    font-size: 0.82rem;
    color: #10b981;
    font-weight: 600;
  }

  /* Two-column layout */
  .dashboard-columns {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 24px;
  }
  @media (max-width: 1024px) {
    .dashboard-columns {
      grid-template-columns: 1fr;
    }
  }

  .admin-panel {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--admin-card-border);
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    overflow: hidden;
  }
  .panel-header {
    padding: 20px 24px;
    border-bottom: 1px solid var(--admin-card-border);
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .panel-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .panel-link {
    font-size: 0.85rem;
    font-weight: 700;
    color: #006837;
    text-decoration: none;
  }
  .panel-link:hover {
    text-decoration: underline;
  }

  /* Compact Table */
  .panel-table {
    width: 100%;
    border-collapse: collapse;
  }
  .panel-table th {
    background: #f8fafc;
    text-align: left;
    padding: 12px 18px;
    font-size: 0.78rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--admin-card-border);
  }
  .panel-table td {
    padding: 14px 18px;
    font-size: 0.9rem;
    color: #334155;
    border-bottom: 1px solid var(--admin-card-border);
    vertical-align: middle;
  }
  .panel-table tr:last-child td {
    border-bottom: none;
  }
  .product-thumb-sm {
    width: 44px;
    height: 44px;
    object-fit: contain;
    background: #f8fafc;
    border-radius: 8px;
    padding: 3px;
    border: 1px solid #e2e8f0;
  }
  .badge {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .badge-instock {
    background: #ecfdf5;
    color: #059669;
  }
  .badge-outofstock {
    background: #fef2f2;
    color: #dc2626;
  }
  .badge-brand {
    background: #eaf5ee;
    color: #006837;
    border: 1px solid #bbf7d0;
  }
  .badge-cat {
    background: #f0fdf4;
    color: #166534;
    font-size: 0.75rem;
  }
  .action-btn {
    padding: 5px 10px;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid #cbd5e1;
    color: #334155;
    background: #ffffff;
  }
  .action-btn:hover {
    background: #f1f5f9;
  }
</style>

<div class="dashboard-header">
  <div class="dashboard-title">
    <h1>Content Overview &amp; Control</h1>
    <p>Live inventory from <code>data/products.json</code> and articles from <code>data/blogs.json</code></p>
  </div>
  <div class="quick-actions">
    <a href="/admin/products/new" class="btn-action-primary">
      <span>➕</span> Add New Product
    </a>
    <a href="/admin/blogs/new" class="btn-action-secondary">
      <span>✍️</span> Write Blog Post
    </a>
  </div>
</div>

<!-- Metrics Cards -->
<div class="metrics-grid">
  <div class="metric-card">
    <div class="metric-head">
      <span class="metric-label">Products in Catalog</span>
      <span class="metric-icon">🦻</span>
    </div>
    <div class="metric-value"><%= stats.totalProducts %></div>
    <div class="metric-sub">✓ <%= stats.inStockCount %> active in stock</div>
  </div>

  <div class="metric-card accent-blue">
    <div class="metric-head">
      <span class="metric-label">Hearing Brands</span>
      <span class="metric-icon">🏷️</span>
    </div>
    <div class="metric-value"><%= stats.totalBrands %></div>
    <div class="metric-sub" style="color: #0284c7;">
      <%= stats.brandsList.slice(0, 3).join(', ') %>
    </div>
  </div>

  <div class="metric-card accent-purple">
    <div class="metric-head">
      <span class="metric-label">Audiology Articles</span>
      <span class="metric-icon">📰</span>
    </div>
    <div class="metric-value"><%= stats.totalBlogs %></div>
    <div class="metric-sub" style="color: #7c3aed;">
      <%= stats.publishedBlogs %> published live
    </div>
  </div>

  <div class="metric-card accent-red">
    <div class="metric-head">
      <span class="metric-label">Featured Showcase</span>
      <span class="metric-icon">⭐</span>
    </div>
    <div class="metric-value"><%= stats.featuredProducts %></div>
    <div class="metric-sub" style="color: #c9252c;">
      Featured on homepage
    </div>
  </div>
</div>

<!-- Two Columns: Recent Products & Recent Blogs -->
<div class="dashboard-columns">
  <!-- Recent Products -->
  <div class="admin-panel">
    <div class="panel-header">
      <h2 class="panel-title">
        <span>🦻</span> Recent Catalog Additions
      </h2>
      <a href="/admin/products" class="panel-link">View All (<%= stats.totalProducts %>) &rarr;</a>
    </div>
    <div style="overflow-x: auto;">
      <table class="panel-table">
        <thead>
          <tr>
            <th>Product</th>
            <th>Brand</th>
            <th>Status</th>
            <th style="text-align: right;">Action</th>
          </tr>
        </thead>
        <tbody>
          <% if (recentProducts && recentProducts.length > 0) { %>
            <% recentProducts.forEach(p => { %>
              <tr>
                <td>
                  <div style="display: flex; align-items: center; gap: 12px;">
                    <img src="<%= p.image %>" alt="" class="product-thumb-sm">
                    <div>
                      <strong style="color: #0f172a; display: block; font-size: 0.92rem;"><%= p.title %></strong>
                      <span style="font-size: 0.78rem; color: #64748b;"><%= p.type %></span>
                    </div>
                  </div>
                </td>
                <td>
                  <span class="badge badge-brand"><%= p.brand %></span>
                </td>
                <td>
                  <% if (p.inStock) { %>
                    <span class="badge badge-instock">In Stock</span>
                  <% } else { %>
                    <span class="badge badge-outofstock">Out of Stock</span>
                  <% } %>
                </td>
                <td style="text-align: right;">
                  <a href="/admin/products/edit/<%= p.id %>" class="action-btn">Edit</a>
                  <a href="/product/<%= p.slug %>" target="_blank" class="action-btn" title="View public page">↗</a>
                </td>
              </tr>
            <% }); %>
          <% } else { %>
            <tr>
              <td colspan="4" style="text-align: center; color: #94a3b8; padding: 24px;">No products yet.</td>
            </tr>
          <% } %>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Recent Blog Posts -->
  <div class="admin-panel">
    <div class="panel-header">
      <h2 class="panel-title">
        <span>📰</span> Audiology Articles
      </h2>
      <a href="/admin/blogs" class="panel-link">Manage Blogs (<%= stats.totalBlogs %>) &rarr;</a>
    </div>
    <div style="padding: 16px 20px;">
      <% if (recentBlogs && recentBlogs.length > 0) { %>
        <% recentBlogs.forEach(b => { %>
          <div style="padding: 14px 0; border-bottom: 1px solid var(--admin-card-border); display: flex; gap: 14px; align-items: flex-start;">
            <img src="<%= b.image %>" alt="" style="width: 56px; height: 56px; border-radius: 10px; object-fit: cover; flex-shrink: 0; background: #eaf5ee;">
            <div style="flex-grow: 1;">
              <span class="badge badge-cat" style="margin-bottom: 4px;"><%= b.category %></span>
              <h4 style="font-size: 0.94rem; font-weight: 700; color: #0f172a; margin-bottom: 4px; line-height: 1.35;">
                <a href="/admin/blogs/edit/<%= b.id %>" style="color: inherit; text-decoration: none;">
                  <%= b.title %>
                </a>
              </h4>
              <div style="font-size: 0.78rem; color: #94a3b8; display: flex; gap: 12px;">
                <span>📅 <%= b.date %></span>
                <span>⏱ <%= b.readTime %></span>
              </div>
            </div>
            <a href="/admin/blogs/edit/<%= b.id %>" class="action-btn" style="flex-shrink: 0;">Edit</a>
          </div>
        <% }); %>
      <% } else { %>
        <p style="text-align: center; color: #94a3b8; padding: 20px 0;">No blog posts created yet.</p>
      <% } %>
    </div>
  </div>
</div>

<%- include('layout-footer') %>
