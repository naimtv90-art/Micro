<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof pageTitle !== 'undefined' ? pageTitle : 'Admin Login – Micro Hearing Care Centre' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    body {
      font-family: 'Plus Jakarta Sans', -apple-system, sans-serif;
      background: linear-gradient(135deg, #06381d 0%, #006837 50%, #0a4d29 100%);
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 24px;
      color: #0f172a;
    }
    .login-container {
      width: 100%;
      max-width: 440px;
      background: #ffffff;
      border-radius: 24px;
      box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.45), 0 0 0 1px rgba(255, 255, 255, 0.1);
      padding: 44px 36px;
      position: relative;
      overflow: hidden;
    }
    .login-container::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      right: 0;
      height: 6px;
      background: linear-gradient(90deg, #006837, #c9252c, #006837);
    }
    .brand-header {
      text-align: center;
      margin-bottom: 32px;
    }
    .brand-header img {
      max-height: 52px;
      width: auto;
      margin-bottom: 16px;
    }
    .brand-badge {
      display: inline-block;
      font-size: 0.72rem;
      font-weight: 800;
      letter-spacing: 0.08em;
      text-transform: uppercase;
      background: #eaf5ee;
      color: #006837;
      padding: 4px 12px;
      border-radius: 9999px;
      border: 1px solid #bbf7d0;
      margin-bottom: 8px;
    }
    .brand-header h1 {
      font-size: 1.5rem;
      font-weight: 800;
      color: #06381d;
      letter-spacing: -0.02em;
    }
    .brand-header p {
      font-size: 0.92rem;
      color: #64748b;
      margin-top: 4px;
    }
    .form-group {
      margin-bottom: 20px;
    }
    .form-label {
      display: block;
      font-size: 0.88rem;
      font-weight: 700;
      color: #334155;
      margin-bottom: 8px;
    }
    .form-control {
      width: 100%;
      padding: 13px 16px;
      border: 1.5px solid #e2e8f0;
      border-radius: 12px;
      font-size: 0.95rem;
      font-family: inherit;
      color: #0f172a;
      transition: all 0.2s ease;
      background: #f8fafc;
    }
    .form-control:focus {
      outline: none;
      border-color: #006837;
      background: #ffffff;
      box-shadow: 0 0 0 4px rgba(0, 104, 55, 0.12);
    }
    .password-wrap {
      position: relative;
    }
    .toggle-pass-btn {
      position: absolute;
      right: 12px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      cursor: pointer;
      font-size: 1rem;
      color: #64748b;
      padding: 4px;
    }
    .btn-login {
      width: 100%;
      padding: 14px 24px;
      background: linear-gradient(135deg, #006837 0%, #0a4d29 100%);
      color: #ffffff;
      border: none;
      border-radius: 12px;
      font-size: 1rem;
      font-weight: 700;
      cursor: pointer;
      transition: all 0.2s ease;
      box-shadow: 0 4px 14px rgba(0, 104, 55, 0.35);
      margin-top: 8px;
    }
    .btn-login:hover {
      background: linear-gradient(135deg, #0a4d29 0%, #06381d 100%);
      transform: translateY(-1px);
      box-shadow: 0 6px 20px rgba(0, 104, 55, 0.45);
    }
    .alert-box {
      background: #fef2f2;
      border: 1px solid #fecaca;
      color: #991b1b;
      padding: 12px 14px;
      border-radius: 10px;
      font-size: 0.88rem;
      font-weight: 600;
      margin-bottom: 20px;
      display: flex;
      align-items: center;
      gap: 8px;
    }
    .credentials-hint {
      margin-top: 24px;
      padding: 12px 16px;
      background: #f1f5f9;
      border-radius: 10px;
      font-size: 0.8rem;
      color: #475569;
      line-height: 1.5;
    }
    .credentials-hint code {
      background: #e2e8f0;
      padding: 2px 6px;
      border-radius: 4px;
      font-weight: 700;
      color: #0f172a;
    }
    .back-link {
      display: block;
      text-align: center;
      margin-top: 20px;
      color: #64748b;
      font-size: 0.88rem;
      text-decoration: none;
      font-weight: 600;
    }
    .back-link:hover {
      color: #006837;
    }
  </style>
</head>
<body>
  <div class="login-container">
    <div class="brand-header">
      <img src="/images/micro-hearing-care-centre-logo-dhaka-bangladesh.png" alt="Micro Hearing Care Centre">
      <div>
        <span class="brand-badge">Administrative Portal</span>
      </div>
      <h1>Micro Hearing CMS</h1>
      <p>Manage Products, Audiology Articles &amp; Content</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="alert-box">
        <span>⚠️</span>
        <span><%= error %></span>
      </div>
    <% } %>

    <form action="/admin/login" method="POST">
      <input type="hidden" name="redirect" value="<%= typeof redirect !== 'undefined' ? redirect : '/admin' %>">

      <div class="form-group">
        <label class="form-label" for="username">Username</label>
        <input type="text" id="username" name="username" class="form-control" placeholder="admin" required autofocus value="admin">
      </div>

      <div class="form-group">
        <label class="form-label" for="password">Password</label>
        <div class="password-wrap">
          <input type="password" id="password" name="password" class="form-control" placeholder="••••••••••••" required>
          <button type="button" class="toggle-pass-btn" onclick="togglePasswordVisibility()" aria-label="Toggle password visibility">👁️</button>
        </div>
      </div>

      <button type="submit" class="btn-login">Sign In to Dashboard &rarr;</button>
    </form>

    <div class="credentials-hint">
      <strong>Default Credentials:</strong><br>
      Username: <code>admin</code> &bull; Password: <code>micro2026!</code>
    </div>

    <a href="/" class="back-link">&larr; Return to Micro Hearing Homepage</a>
  </div>

  <script>
    function togglePasswordVisibility() {
      const pass = document.getElementById('password');
      if (pass.type === 'password') {
        pass.type = 'text';
      } else {
        pass.type = 'password';
      }
    }
  </script>
</body>
</html>
