<%- include('layout-header', { pageTitle: (isEdit ? 'Edit Product' : 'Add New Product') + ' – Micro Hearing CMS', activeNav: 'products' }) %>

<style>
  .form-container {
    max-width: 900px;
    margin: 0 auto;
  }
  .form-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .form-header h1 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #06381d;
  }
  .form-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--admin-card-border);
    padding: 32px;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
    margin-bottom: 24px;
  }
  .form-section-title {
    font-size: 1.1rem;
    font-weight: 800;
    color: #0f172a;
    margin-bottom: 20px;
    padding-bottom: 12px;
    border-bottom: 1px solid #f1f5f9;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .form-grid-2 {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  @media (max-width: 768px) {
    .form-grid-2 {
      grid-template-columns: 1fr;
    }
  }
  .form-group {
    margin-bottom: 20px;
  }
  .form-label {
    display: block;
    font-size: 0.88rem;
    font-weight: 700;
    color: #334155;
    margin-bottom: 8px;
  }
  .form-label .required {
    color: #dc2626;
  }
  .form-control {
    width: 100%;
    padding: 12px 16px;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.95rem;
    font-family: inherit;
    color: #0f172a;
    transition: all 0.2s ease;
    background: #ffffff;
  }
  .form-control:focus {
    outline: none;
    border-color: #006837;
    box-shadow: 0 0 0 3px rgba(0, 104, 55, 0.12);
  }
  .form-hint {
    font-size: 0.78rem;
    color: #64748b;
    margin-top: 6px;
  }

  /* Image Upload Zone */
  .upload-dropzone {
    border: 2px dashed #cbd5e1;
    border-radius: 14px;
    padding: 28px;
    text-align: center;
    background: #f8fafc;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .upload-dropzone:hover {
    border-color: #006837;
    background: #f0fdf4;
  }
  .preview-wrapper {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-top: 16px;
    padding: 14px;
    background: #f8fafc;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
  }
  .preview-img {
    width: 90px;
    height: 90px;
    object-fit: contain;
    background: #ffffff;
    border-radius: 8px;
    padding: 6px;
    border: 1px solid #cbd5e1;
  }

  /* Switches / Checkboxes */
  .switch-row {
    display: flex;
    gap: 24px;
    flex-wrap: wrap;
    background: #f8fafc;
    padding: 16px 20px;
    border-radius: 12px;
    border: 1px solid #e2e8f0;
    margin-bottom: 20px;
  }
  .checkbox-label {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 700;
    font-size: 0.92rem;
    color: #1e293b;
    cursor: pointer;
  }
  .checkbox-label input {
    width: 18px;
    height: 18px;
    accent-color: #006837;
  }

  /* Form Action Buttons */
  .form-actions {
    display: flex;
    justify-content: flex-end;
    gap: 14px;
    margin-top: 28px;
  }
  .btn-submit {
    padding: 13px 32px;
    background: linear-gradient(135deg, #006837 0%, #0a4d29 100%);
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 12px rgba(0, 104, 55, 0.3);
  }
  .btn-submit:hover {
    background: linear-gradient(135deg, #0a4d29 0%, #06381d 100%);
  }
  .btn-cancel {
    padding: 13px 24px;
    background: #f1f5f9;
    color: #475569;
    border: 1px solid #cbd5e1;
    border-radius: 10px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
</style>

<div class="form-container">
  <div class="form-header">
    <div>
      <h1><%= isEdit ? 'Edit Product' : 'Add New Hearing Aid' %></h1>
      <p style="color: #64748b; font-size: 0.92rem; margin-top: 4px;">
        <%= isEdit ? 'Update product details, brand, form factor and images.' : 'Create a new product listing for Micro Hearing Care Centre.' %>
      </p>
    </div>
    <a href="/admin/products" class="btn-cancel">&larr; Back to Products</a>
  </div>

  <form action="<%= isEdit ? ('/admin/products/edit/' + product.id) : '/admin/products/new' %>" method="POST" enctype="multipart/form-data">
    <div class="form-card">
      <div class="form-section-title">
        <span>🏷️</span> Basic Information
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label" for="title">Product Title <span class="required">*</span></label>
          <input type="text" id="title" name="title" class="form-control" placeholder="e.g. Phonak Naida Lumity L90 UP" required value="<%= product.title %>">
          <div class="form-hint">Official brand model and power variant.</div>
        </div>

        <div class="form-group">
          <label class="form-label" for="slug">URL Slug</label>
          <input type="text" id="slug" name="slug" class="form-control" placeholder="e.g. phonak-naida-lumity-l90-up" value="<%= product.slug %>">
          <div class="form-hint">Public URL: <code>/product/&lt;slug&gt;</code> (Auto-generated if left blank).</div>
        </div>
      </div>

      <div class="form-grid-2">
        <div class="form-group">
          <label class="form-label" for="brandSelect">Manufacturer Brand <span class="required">*</span></label>
          <select id="brandSelect" name="brand" class="form-control" onchange="toggleCustomBrand(this)">
            <% brands.forEach(b => { %>
              <option value="<%= b %>" <%= product.brand === b ? 'selected' : '' %>><%= b %></option>
            <% }); %>
            <option value="__custom__">+ Add New Brand...</option>
          </select>
          <div id="customBrandWrap" style="display: none; margin-top: 10px;">
            <input type="text" name="customBrand" class="form-control" placeholder="Enter new brand name">
          </div>
        </div>

        <div class="form-group">
          <label class="form-label" for="typeSelect">Style / Form Factor <span class="required">*</span></label>
          <select id="typeSelect" name="type" class="form-control" onchange="toggleCustomType(this)">
            <% types.forEach(t => { %>
              <option value="<%= t %>" <%= product.type === t ? 'selected' : '' %>><%= t %></option>
            <% }); %>
            <option value="__custom__">+ Add Custom Style...</option>
          </select>
          <div id="customTypeWrap" style="display: none; margin-top: 10px;">
            <input type="text" name="customType" class="form-control" placeholder="e.g. Receiver-in-Canal (RIC)">
          </div>
        </div>
      </div>
    </div>

    <!-- Media & Images -->
    <div class="form-card">
      <div class="form-section-title">
        <span>📸</span> Product Media &amp; Image
      </div>

      <div class="form-group">
        <label class="form-label">Upload Product Image (JPG, PNG, WebP)</label>
        <div class="upload-dropzone" onclick="document.getElementById('imageFileInput').click()">
          <span style="font-size: 2.2rem; display: block; margin-bottom: 8px;">📁</span>
          <strong style="color: #006837;">Click to choose an image</strong> or drag and drop file here
          <p style="font-size: 0.8rem; color: #64748b; margin-top: 4px;">Max file size: 10MB. Automatically stored in <code>/public/images/cms/</code></p>
          <input type="file" id="imageFileInput" name="imageFile" accept="image/*" style="display: none;" onchange="previewUpload(this)">
        </div>
      </div>

      <div class="form-group">
        <label class="form-label" for="imageUrl">Or Enter Existing Image URL / Path</label>
        <input type="text" id="imageUrl" name="imageUrl" class="form-control" placeholder="/images/micro-phonak-naida-bte-digital-hearing-aid-uttara-bangladesh.png" value="<%= product.image %>" oninput="previewUrl(this.value)">
      </div>

      <div class="preview-wrapper" id="previewBox" style="<%= product.image ? '' : 'display: none;' %>">
        <img src="<%= product.image || '' %>" alt="Preview" class="preview-img" id="imgPreview">
        <div>
          <strong style="color: #0f172a; display: block; font-size: 0.92rem;">Active Image Preview</strong>
          <span style="font-size: 0.8rem; color: #64748b;" id="previewText"><%= product.image || 'Image loaded' %></span>
        </div>
      </div>
    </div>

    <!-- Inventory & Settings -->
    <div class="form-card">
      <div class="form-section-title">
        <span>⚙️</span> Inventory &amp; Description
      </div>

      <div class="switch-row">
        <label class="checkbox-label">
          <input type="checkbox" name="inStock" <%= product.inStock ? 'checked' : '' %>>
          <span>In Stock &amp; Available for Trial</span>
        </label>

        <label class="checkbox-label">
          <input type="checkbox" name="featured" <%= product.featured ? 'checked' : '' %>>
          <span>Featured on Homepage Slider &amp; Highlights</span>
        </label>
      </div>

      <div class="form-group">
        <label class="form-label" for="description">Product Description &amp; Technical Specs</label>
        <textarea id="description" name="description" rows="5" class="form-control" placeholder="Provide detailed audiological information, channel count, battery size, and target hearing loss range..."><%= product.description %></textarea>
        <div class="form-hint">Displayed on product detail page alongside MHCC patient warranty and trial inclusions.</div>
      </div>

      <div class="form-group">
        <label class="form-label" for="originalUrl">Original URL / Manufacturer Reference (Optional)</label>
        <input type="text" id="originalUrl" name="originalUrl" class="form-control" placeholder="https://microhearingaidbd.com/product/..." value="<%= product.originalUrl || '' %>">
      </div>
    </div>

    <div class="form-actions">
      <a href="/admin/products" class="btn-cancel">Cancel</a>
      <button type="submit" class="btn-submit">
        <%= isEdit ? '💾 Save Changes' : '✓ Publish Product' %>
      </button>
    </div>
  </form>
</div>

<script>
  // Auto slugify on title type (only for new products or empty slug)
  const isEditMode = <%= isEdit ? 'true' : 'false' %>;
  const titleInput = document.getElementById('title');
  const slugInput = document.getElementById('slug');

  if (!isEditMode) {
    titleInput.addEventListener('input', () => {
      slugInput.value = titleInput.value
        .toLowerCase()
        .trim()
        .replace(/\s+/g, '-')
        .replace(/[^\w\-]+/g, '')
        .replace(/\-\-+/g, '-')
        .replace(/^-+/, '')
        .replace(/-+$/, '');
    });
  }

  function toggleCustomBrand(select) {
    const wrap = document.getElementById('customBrandWrap');
    wrap.style.display = select.value === '__custom__' ? 'block' : 'none';
  }

  function toggleCustomType(select) {
    const wrap = document.getElementById('customTypeWrap');
    wrap.style.display = select.value === '__custom__' ? 'block' : 'none';
  }

  function previewUpload(input) {
    if (input.files && input.files[0]) {
      const file = input.files[0];
      const reader = new FileReader();
      reader.onload = function(e) {
        document.getElementById('imgPreview').src = e.target.result;
        document.getElementById('previewBox').style.display = 'flex';
        document.getElementById('previewText').textContent = file.name + ' (' + Math.round(file.size / 1024) + ' KB)';
      };
      reader.readAsDataURL(file);
    }
  }

  function previewUrl(url) {
    if (url && url.trim()) {
      document.getElementById('imgPreview').src = url.trim();
      document.getElementById('previewBox').style.display = 'flex';
      document.getElementById('previewText').textContent = url.trim();
    }
  }

  // Prevent multiple submits and show loading
  const productForm = document.querySelector('form');
  if (productForm) {
    productForm.addEventListener('submit', function() {
      const submitBtn = productForm.querySelector('.btn-submit');
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.innerText = 'Saving... Please wait';
        submitBtn.style.opacity = '0.7';
      }
    });
  }
</script>

<%- include('layout-footer') %>
