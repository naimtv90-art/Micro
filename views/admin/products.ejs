<%- include('layout-header', { pageTitle: 'Product Catalog – Micro Hearing CMS', activeNav: 'products' }) %>

<style>
  .page-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
    flex-wrap: wrap;
    gap: 16px;
  }
  .page-header h1 {
    font-size: 1.65rem;
    font-weight: 800;
    color: #06381d;
  }
  .filters-card {
    background: #ffffff;
    border-radius: 14px;
    padding: 16px 20px;
    border: 1px solid var(--admin-card-border);
    margin-bottom: 24px;
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    box-shadow: 0 1px 4px rgba(0,0,0,0.02);
  }
  .search-box {
    flex: 1;
    min-width: 240px;
    position: relative;
  }
  .search-box input {
    width: 100%;
    padding: 10px 14px 10px 36px;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.9rem;
    font-family: inherit;
  }
  .search-box .icon {
    position: absolute;
    left: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #94a3b8;
    pointer-events: none;
  }
  .filter-select {
    padding: 10px 14px;
    border: 1.5px solid #cbd5e1;
    border-radius: 10px;
    font-size: 0.9rem;
    font-family: inherit;
    background: #ffffff;
    color: #334155;
    font-weight: 600;
  }
  .btn-filter {
    padding: 10px 18px;
    background: #006837;
    color: #ffffff;
    border: none;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 700;
    cursor: pointer;
  }
  .btn-filter:hover {
    background: #0a4d29;
  }
  .btn-reset {
    padding: 10px 14px;
    background: #f1f5f9;
    color: #475569;
    border: none;
    border-radius: 10px;
    font-size: 0.9rem;
    font-weight: 600;
    text-decoration: none;
  }

  /* Table Container */
  .table-card {
    background: #ffffff;
    border-radius: 16px;
    border: 1px solid var(--admin-card-border);
    overflow: hidden;
    box-shadow: 0 2px 8px rgba(0,0,0,0.03);
  }
  .data-table {
    width: 100%;
    border-collapse: collapse;
  }
  .data-table th {
    background: #f8fafc;
    text-align: left;
    padding: 14px 20px;
    font-size: 0.8rem;
    font-weight: 700;
    color: #64748b;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-bottom: 1px solid var(--admin-card-border);
  }
  .data-table td {
    padding: 14px 20px;
    font-size: 0.92rem;
    color: #334155;
    border-bottom: 1px solid var(--admin-card-border);
    vertical-align: middle;
  }
  .data-table tr:hover td {
    background: #f8faf9;
  }
  .product-thumb {
    width: 50px;
    height: 50px;
    object-fit: contain;
    background: #f8fafc;
    border-radius: 8px;
    padding: 4px;
    border: 1px solid #e2e8f0;
  }
  .badge-tag {
    display: inline-block;
    padding: 3px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
  }
  .badge-featured {
    background: #fef3c7;
    color: #b45309;
    font-size: 0.72rem;
    margin-left: 6px;
  }
  .btn-add {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: #006837;
    color: #ffffff;
    padding: 11px 20px;
    border-radius: 10px;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
    box-shadow: 0 4px 10px rgba(0, 104, 55, 0.25);
  }
  .btn-add:hover {
    background: #0a4d29;
  }
  .actions-cell {
    display: flex;
    gap: 8px;
    align-items: center;
    justify-content: flex-end;
  }
  .btn-icon {
    padding: 6px 12px;
    border-radius: 8px;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    border: 1px solid #cbd5e1;
    color: #334155;
    background: #ffffff;
    cursor: pointer;
  }
  .btn-icon:hover {
    background: #f1f5f9;
  }
  .btn-delete {
    color: #dc2626;
    border-color: #fca5a5;
    background: #fff;
  }
  .btn-delete:hover {
    background: #fee2e2;
  }
</style>

<div class="page-header">
  <div>
    <h1>Products Catalog</h1>
    <p style="color: #64748b; font-size: 0.95rem; margin-top: 4px;">
      Showing <%= products.length %> hearing aid items and audiology accessories
    </p>
  </div>
  <a href="/admin/products/new" class="btn-add">
    <span>➕</span> Add New Product
  </a>
</div>

<!-- Filters Bar -->
<form action="/admin/products" method="GET" class="filters-card">
  <div class="search-box">
    <span class="icon">🔍</span>
    <input type="text" name="search" placeholder="Search by model, brand, or style..." value="<%= searchQuery %>">
  </div>

  <select name="brand" class="filter-select">
    <% brands.forEach(b => { %>
      <option value="<%= b %>" <%= selectedBrand === b ? 'selected' : '' %>><%= b === 'All' ? 'All Brands' : b %></option>
    <% }); %>
  </select>

  <select name="type" class="filter-select">
    <% types.forEach(t => { %>
      <option value="<%= t %>" <%= selectedType === t ? 'selected' : '' %>><%= t === 'All' ? 'All Types / Styles' : t %></option>
    <% }); %>
  </select>

  <select name="stock" class="filter-select">
    <option value="all" <%= selectedStock === 'all' ? 'selected' : '' %>>All Availability</option>
    <option value="in" <%= selectedStock === 'in' ? 'selected' : '' %>>In Stock Only</option>
    <option value="out" <%= selectedStock === 'out' ? 'selected' : '' %>>Out of Stock</option>
  </select>

  <button type="submit" class="btn-filter">Filter</button>
  <% if (searchQuery || selectedBrand !== 'All' || selectedType !== 'All' || selectedStock !== 'all') { %>
    <a href="/admin/products" class="btn-reset">Clear Filters</a>
  <% } %>
</form>

<!-- Table -->
<div class="table-card">
  <div style="overflow-x: auto;">
    <table class="data-table">
      <thead>
        <tr>
          <th style="width: 70px;">Image</th>
          <th>Title &amp; Slug</th>
          <th>Brand</th>
          <th>Form Factor / Type</th>
          <th>Status</th>
          <th style="text-align: right;">Actions</th>
        </tr>
      </thead>
      <tbody>
        <% if (products && products.length > 0) { %>
          <% products.forEach(p => { %>
            <tr>
              <td>
                <img src="<%= p.image %>" alt="" class="product-thumb">
              </td>
              <td>
                <div style="font-weight: 800; color: #0f172a; font-size: 0.95rem; margin-bottom: 2px;">
                  <%= p.title %>
                  <% if (p.featured) { %>
                    <span class="badge-tag badge-featured">★ Featured</span>
                  <% } %>
                </div>
                <div style="font-size: 0.78rem; color: #94a3b8; font-family: monospace;">
                  /product/<%= p.slug %>
                </div>
              </td>
              <td>
                <span class="badge-tag" style="background: #eaf5ee; color: #006837; border: 1px solid #bbf7d0;">
                  <%= p.brand %>
                </span>
              </td>
              <td>
                <span style="font-size: 0.86rem; color: #475569;">
                  <%= p.type %>
                </span>
              </td>
              <td>
                <% if (p.inStock) { %>
                  <span class="badge-tag" style="background: #ecfdf5; color: #059669;">● In Stock</span>
                <% } else { %>
                  <span class="badge-tag" style="background: #fef2f2; color: #dc2626;">● Out of Stock</span>
                <% } %>
              </td>
              <td>
                <div class="actions-cell">
                  <a href="/product/<%= p.slug %>" target="_blank" class="btn-icon" title="View live page">↗ View</a>
                  <a href="/admin/products/edit/<%= p.id %>" class="btn-icon">✏️ Edit</a>
                  <form action="/admin/products/delete/<%= p.id %>" method="POST" style="margin: 0;" onsubmit="return confirm('Are you sure you want to permanently delete this product? This action cannot be undone.');">
                    <button type="submit" class="btn-icon btn-delete" title="Delete product">🗑️</button>
                  </form>
                </div>
              </td>
            </tr>
          <% }); %>
        <% } else { %>
          <tr>
            <td colspan="6" style="text-align: center; color: #94a3b8; padding: 40px;">
              No products match your search or filter. <a href="/admin/products" style="color: #006837; font-weight: 700;">Reset filters</a>
            </td>
          </tr>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('layout-footer') %>
